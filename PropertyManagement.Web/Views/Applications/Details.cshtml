@model PropertyManagement.Web.ViewModels.RentalApplications.RentalApplicationViewModel

@using PropertyManagement.Web.ViewModels.RentalApplications

@{
    ViewData["Title"] = $"Rental Application #{Model.ApplicationId}";
}

@* A plain link, so like Back it never saves the current section. *@
<p class="mb-2">
    <a asp-controller="AvailableUnits" asp-action="Index">&larr; Back to available units</a>
</p>

<h1>Rental Application #@Model.ApplicationId</h1>

<p>Status: <strong>@Model.Status</strong></p>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

@if (Model.IsReadOnly)
{
    <partial name="_SummarySection" model="Model" />
}
else
{
    <form asp-action="Navigate"
          asp-route-id="@Model.ApplicationId"
          method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="ApplicationId" />
        <input type="hidden" asp-for="Section" />

        <p class="text-muted mb-3">
            Step @Model.Section.StepNumber() of @RentalApplicationSectionExtensions.StepCount:
            <strong>@Model.Section.DisplayName()</strong>
        </p>

        @switch (Model.Section)
        {
            case PropertyManagement.Web.ViewModels.RentalApplications.RentalApplicationSection.ApplicantInformation:
                <partial name="_ApplicantInformationSection" model="Model" />
                break;

            case PropertyManagement.Web.ViewModels.RentalApplications.RentalApplicationSection.ResidenceHistory:
                <partial name="_ResidenceHistorySection" model="Model" />
                break;

            case PropertyManagement.Web.ViewModels.RentalApplications.RentalApplicationSection.Summary:
                <partial name="_SummarySection" model="Model" />
                break;
        }

        <div class="mt-3 d-flex gap-2">
            @if (Model.Section !=
                PropertyManagement.Web.ViewModels.RentalApplications.RentalApplicationSection.ApplicantInformation)
            {
                <button type="submit"
                        name="command"
                        value="Back"
                        class="btn btn-secondary">
                    Back
                </button>
            }

            @if (Model.Section ==
                PropertyManagement.Web.ViewModels.RentalApplications.RentalApplicationSection.Summary)
            {
                <button type="submit"
                        name="command"
                        value="Submit"
                        class="btn btn-primary">
                    Submit Application
                </button>
            }
            else
            {
                <button type="submit"
                        name="command"
                        value="Continue"
                        class="btn btn-primary">
                    Continue
                </button>
            }
        </div>
    </form>
}

@* Outside the Continue/Back form so modal forms are never nested in it. *@
<partial name="_Modal" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
