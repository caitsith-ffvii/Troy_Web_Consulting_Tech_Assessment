@model PropertyManagement.Web.ViewModels.RentalApplications.RentalApplicationViewModel

@* One partial for both modes; IsReadOnly is decided on the server. *@
<h2 class="h4">Applicant Information</h2>

@if (Model.IsReadOnly)
{
    <dl class="row">
        <dt class="col-sm-3">First Name</dt>
        <dd class="col-sm-9">@Model.ApplicantInformation.FirstName</dd>

        <dt class="col-sm-3">Last Name</dt>
        <dd class="col-sm-9">@Model.ApplicantInformation.LastName</dd>

        <dt class="col-sm-3">Phone</dt>
        <dd class="col-sm-9">@Model.ApplicantInformation.PhoneNumber</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.ApplicantInformation.Email</dd>

        <dt class="col-sm-3">Current Address</dt>
        <dd class="col-sm-9">@Model.ApplicantInformation.CurrentAddress</dd>
    </dl>
}
else
{
    <div class="mb-3">
        <label asp-for="ApplicantInformation.FirstName" class="form-label"></label>
        <input asp-for="ApplicantInformation.FirstName" class="form-control" />
        <span asp-validation-for="ApplicantInformation.FirstName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ApplicantInformation.LastName" class="form-label"></label>
        <input asp-for="ApplicantInformation.LastName" class="form-control" />
        <span asp-validation-for="ApplicantInformation.LastName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ApplicantInformation.PhoneNumber" class="form-label"></label>
        <input asp-for="ApplicantInformation.PhoneNumber" class="form-control" type="tel" data-phone placeholder="(555) 444-2912" />
        <span asp-validation-for="ApplicantInformation.PhoneNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ApplicantInformation.Email" class="form-label"></label>
        <input asp-for="ApplicantInformation.Email" class="form-control" />
        <span asp-validation-for="ApplicantInformation.Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ApplicantInformation.CurrentAddress" class="form-label"></label>
        <input asp-for="ApplicantInformation.CurrentAddress" class="form-control" />
        <span asp-validation-for="ApplicantInformation.CurrentAddress" class="text-danger"></span>
    </div>
}
