@model PropertyManagement.Web.ViewModels.RentalApplications.ResidenceHistoryEntryViewModel

@{
    var applicationId = (int)ViewData["ApplicationId"]!;
    var isEdit = Model.Id > 0;
}

<form asp-controller="Applications"
      asp-action="@(isEdit ? "EditResidence" : "AddResidence")"
      asp-route-id="@applicationId"
      asp-route-entryId="@(isEdit ? Model.Id : (int?)null)"
      method="post">
    <div class="modal-header">
        <h2 class="modal-title fs-5">@(isEdit ? "Edit residence" : "Add residence")</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Address" class="form-label"></label>
            <input asp-for="Address" class="form-control" />
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="LandlordName" class="form-label"></label>
            <input asp-for="LandlordName" class="form-control" />
            <span asp-validation-for="LandlordName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="LandlordPhoneNumber" class="form-label"></label>
            <input asp-for="LandlordPhoneNumber" class="form-control" />
            <span asp-validation-for="LandlordPhoneNumber" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-sm-6 mb-3">
                <label asp-for="MoveInDate" class="form-label"></label>
                <input asp-for="MoveInDate" class="form-control" />
                <span asp-validation-for="MoveInDate" class="text-danger"></span>
            </div>

            <div class="col-sm-6 mb-3">
                <label asp-for="MoveOutDate" class="form-label"></label>
                <input asp-for="MoveOutDate" class="form-control" />
                <span asp-validation-for="MoveOutDate" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
