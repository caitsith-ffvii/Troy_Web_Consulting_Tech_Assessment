@model PropertyManagement.Web.ViewModels.RentalApplications.RentalApplicationViewModel

@* The Summary is the two section partials rendered read-only. Paths are
   absolute because the manager details page renders this partial too. *@
@{
    var readOnly = Model.AsReadOnly();
}

<h2>Application Summary</h2>

<p class="mb-1">
    Applicant Information:
    <strong>@(Model.ApplicantInformationCompleted ? "Complete" : "Incomplete")</strong>
</p>

<p>
    Residence History:
    <strong>@(Model.ResidenceHistoryCompleted ? "Complete" : "Incomplete")</strong>
</p>

<partial name="~/Views/Applications/_ApplicantInformationSection.cshtml" model="readOnly" />

<partial name="~/Views/Applications/_ResidenceHistorySection.cshtml" model="readOnly" />
