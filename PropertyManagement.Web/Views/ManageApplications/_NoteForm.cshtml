@model PropertyManagement.Web.ViewModels.RentalApplications.NoteFormViewModel

@{
    var isEdit = Model.NoteId.HasValue;
}

<form asp-controller="ManageApplications"
      asp-action="@(isEdit ? "EditNote" : "AddNote")"
      asp-route-id="@Model.ApplicationId"
      asp-route-noteId="@Model.NoteId"
      method="post">
    <div class="modal-header">
        <h2 class="modal-title fs-5">@(isEdit ? "Edit note" : "Add note")</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <p class="small text-muted">Visible only to property managers.</p>

        <div class="mb-3">
            <label asp-for="Body" class="form-label"></label>
            <textarea asp-for="Body" class="form-control" rows="5"></textarea>
            <span asp-validation-for="Body" class="text-danger"></span>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
