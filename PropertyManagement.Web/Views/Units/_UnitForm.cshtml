@model UnitFormViewModel

@{
    var isEdit = Model.Id.HasValue;
}

<form asp-controller="Units"
      asp-action="@(isEdit ? "Edit" : "Create")"
      asp-route-id="@Model.Id"
      method="post">
    <input type="hidden" asp-for="PropertyId" />

    <div class="modal-header">
        <h2 class="modal-title fs-5">@(isEdit ? "Edit unit" : "Add unit")</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="UnitNumber" class="form-label"></label>
            <input asp-for="UnitNumber" class="form-control" />
            <span asp-validation-for="UnitNumber" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="UnitTypeId" class="form-label"></label>
            @await Component.InvokeAsync("UnitTypeSelect", new
            {
                selectedUnitTypeId = Model.UnitTypeId,
                currentUnitTypeId = Model.CurrentUnitTypeId
            })
            <span asp-validation-for="UnitTypeId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Bedrooms" class="form-label"></label>
            <input asp-for="Bedrooms" class="form-control" min="0" max="20" />
            <span asp-validation-for="Bedrooms" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="MonthlyRent" class="form-label"></label>
            <input asp-for="MonthlyRent" class="form-control" type="number" step="0.01" min="0.01" />
            <span asp-validation-for="MonthlyRent" class="text-danger"></span>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
